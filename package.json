{
  "name": "@agent-teams/identity-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Identity service and versioned contracts for independent product consumers.",
  "type": "module",
  "scripts": {
    "foundation:check": "agent-teams-foundation check --consumer .",
    "foundation:status": "agent-teams-foundation status --consumer .",
    "foundation:attach": "agent-teams-foundation attach --consumer .",
    "foundation:detach": "agent-teams-foundation detach --consumer .",
    "foundation:assert-dev-only": "agent-teams-foundation assert-dev-only",
    "foundation:assert-registry": "agent-teams-foundation assert-registry",
    "toolchain:doctor": "stack-toolchain doctor",
    "typecheck": "stack-toolchain typecheck",
    "lint:typed": "stack-toolchain lint",
    "topology:check": "node tools/project-topology.ts",
    "architecture:check": "node tools/check-feature-modules.ts",
    "quality:coverage:scope": "agent-teams-foundation quality check --consumer . --scope-only",
    "quality:coverage": "agent-teams-foundation quality check --consumer .",
    "format:check": "agent-teams-foundation quality format --consumer .",
    "format:scope": "agent-teams-foundation quality format --consumer . --scope-only",
    "format:support:check": "node scripts/check-format-inputs.ts --check",
    "format:qualify": "node tools/qualify-format-authority.ts",
    "contracts:check": "node tools/check-contracts.ts",
    "specifications:mutation": "node tools/check-account-mutations.ts",
    "build": "node tools/clean-build.ts && stack-toolchain compile --build tsconfig.build.json && stack-toolchain compile --project tsconfig.tests.json && node tools/record-build-evidence.ts",
    "test": "node tools/run-tests.ts",
    "test:native-authentication": "node tools/check-native-keycloak.ts",
    "test:native-gettok": "node tools/check-native-keycloak.ts --consumer=gettok",
    "test:postgresql-recovery": "node tools/check-postgresql-recovery.ts",
    "check:static": "pnpm toolchain:doctor && pnpm foundation:assert-dev-only && pnpm foundation:assert-registry && pnpm topology:check && pnpm architecture:check && pnpm quality:coverage:scope && pnpm typecheck && pnpm lint:typed && pnpm quality:coverage && pnpm foundation:check",
    "check": "pnpm build && pnpm check:static && pnpm contracts:check && pnpm specifications:mutation && pnpm test && pnpm format:qualify && pnpm format:check",
    "check:fast": "pnpm check",
    "check:changed": "agent-teams-foundation agent-workflow check-changed --consumer .",
    "check:changed:repository": "pnpm check"
  },
  "devDependencies": {
    "@agent-teams/engineering-foundation": "4.0.2",
    "@agent-teams/feature-module-standard": "0.4.3",
    "@bufbuild/buf": "catalog:",
    "@bufbuild/protoc-gen-es": "catalog:",
    "@get-modular/conformance": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "stack-toolchain": "0.3.1",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=26.11.1 <27",
    "pnpm": "11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
